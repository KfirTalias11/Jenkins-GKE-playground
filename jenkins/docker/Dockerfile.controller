ARG JAVA_VERSION=21
FROM eclipse-temurin:${JAVA_VERSION}-jre-noble AS builder
ARG JENKINS_VERSION=2.568.2
ARG PLUGIN_CLI_VERSION=2.15.0
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY plugins.txt .
RUN curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors "https://archives.jenkins.io/war-stable/${JENKINS_VERSION}/jenkins.war" -o jenkins.war \
 && curl -fsSL --retry 5 --retry-delay 3 --retry-all-errors "https://github.com/jenkinsci/plugin-installation-manager-tool/releases/download/${PLUGIN_CLI_VERSION}/jenkins-plugin-manager-${PLUGIN_CLI_VERSION}.jar" -o plugin-manager.jar \
 && java -jar plugin-manager.jar \
      --war /build/jenkins.war \
      --plugin-file /build/plugins.txt \
      --plugin-download-directory /build/plugins \
      --jenkins-update-center-download-url https://archives.jenkins.io/plugins

FROM eclipse-temurin:${JAVA_VERSION}-jre-noble
ENV JENKINS_HOME=/var/jenkins_home \
    JENKINS_WAR=/opt/jenkins/jenkins.war \
    JAVA_OPTS="-Djenkins.install.runSetupWizard=false" \
    JENKINS_OPTS="--httpPort=8080"
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN userdel -r ubuntu 2>/dev/null || true \
 && groupadd -g 1000 jenkins \
 && useradd -u 1000 -g 1000 -m -d "$JENKINS_HOME" jenkins \
 && mkdir -p /opt/jenkins "$JENKINS_HOME/plugins" \
 && chown -R 1000:1000 /opt/jenkins "$JENKINS_HOME"
COPY --from=builder --chown=1000:1000 /build/jenkins.war /opt/jenkins/jenkins.war
COPY --from=builder --chown=1000:1000 /build/plugins/ /var/jenkins_home/plugins/
USER 1000:1000
WORKDIR /var/jenkins_home
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar $JENKINS_WAR $JENKINS_OPTS"]